# Optional overrides for `docker compose up --build`
# Copy to `.env` in the repo root to customize secrets and OAuth.

BETTER_AUTH_SECRET=dev-veritas-better-auth-secret-32chars
INTERNAL_AUTH_BOOTSTRAP_SECRET=dev-veritas-bootstrap-secret

# When frontend runs on the host (hybrid), leave default.
# When frontend also runs in Compose: BETTER_AUTH_INTERNAL_URL=http://frontend:3000
# BETTER_AUTH_INTERNAL_URL=http://host.docker.internal:3000

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
