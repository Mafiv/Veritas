# Veritas backend environment
APP_ENV=development
DEBUG=true
SECRET_KEY=dev-veritas-secret-change-in-production-32
API_V1_PREFIX=/api/v1
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

DATABASE_URL=postgresql+asyncpg://veritas:veritas@db:5432/veritas
DATABASE_URL_SYNC=postgresql://veritas:veritas@db:5432/veritas
REDIS_URL=redis://redis:6379/0

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/storage
S3_BUCKET=veritas-documents
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

USE_MOCK_LLM=true
# Chat completions (LiteLLM) — set LLM_MODEL + matching API key, then USE_MOCK_LLM=false
LLM_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
# GitHub Personal Access Token for GitHub Models (marketplace) — free tier, rate-limited, good for local testing
GITHUB_API_KEY=
ANTHROPIC_API_KEY=
# DeepSeek: LLM_MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Embeddings: local (fastembed, no API key) | openai | mock (tests only)
# EMBEDDING_DIMENSIONS must match the vector(384) column; for OpenAI use
# EMBEDDING_MODEL=text-embedding-3-small (shortened to 384 dims).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
CHAT_MODEL=gpt-4o-mini
CHAT_FALLBACK_MODEL=gpt-3.5-turbo

HYBRID_VECTOR_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4
RETRIEVAL_TOP_K=20
RERANK_TOP_K=8
# Extra LLM calls per chat (HyDE + query rewrite). Disable on free GitHub Models to avoid 429s.
ENABLE_HYDE=false
ENABLE_QUERY_EXPANSION=false
ENABLE_RERANKER=true
# lexical (default, best on our eval) | cross_encoder (MS MARCO MiniLM via fastembed)
RERANKER_BACKEND=lexical
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Abstain (no LLM call) below this top reranker score; tune via `python -m evaluation.run`.
MIN_RELEVANCE_SCORE=0.2

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Better Auth (Next.js) — JWKS base URL + shared bootstrap secret
BETTER_AUTH_URL=http://localhost:3000
# Docker only: internal URL for JWKS fetch (issuer/audience stay BETTER_AUTH_URL)
BETTER_AUTH_INTERNAL_URL=
INTERNAL_AUTH_BOOTSTRAP_SECRET=dev-veritas-bootstrap-secret

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

FREE_TIER_QUERIES_PER_DAY=20
FREE_TIER_DOCUMENTS=5
FREE_TIER_WORKSPACES=1
