# Copy to .env.local for `npm run dev`.

# Better Auth (sessions + JWT issued to the FastAPI backend)
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# Better Auth tables live in the same Postgres as the API
DATABASE_URL=postgresql://veritas:veritas@localhost:5432/veritas

# Must equal INTERNAL_AUTH_BOOTSTRAP_SECRET in backend/.env
INTERNAL_AUTH_BOOTSTRAP_SECRET=change-me-bootstrap-secret

# FastAPI backend: browser-facing URL, and server-side URL (Docker network)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
INTERNAL_API_URL=http://localhost:8000/api/v1

# Optional Google OAuth (redirect URI: http://localhost:3000/api/auth/callback/google)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
